# Direccion donde escucha el servidor HTTP del backend
DIRECCION_ESCUCHA=:8080

# URL de conexion a CockroachDB (motor sistemas_unificados)
# Local (dev, insecure):
BASE_DATOS_URL=postgresql://root@localhost:26258/sistemas_unificados?sslmode=disable

# Clave maestra de cifrado de la boveda (AES-256, 32 bytes en base64).
# Generar una nueva con: cripto.GenerarClaveAleatoriaAES256() o:
# openssl rand -base64 32
KEK_GESTOR=
